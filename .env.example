# Copiar a ".env" (no subir ".env" al repositorio)
TECNICOS_DB_PASSWORD=cambiar_esto
SOLICITUDES_DB_PASSWORD=cambiar_esto
KEYCLOAK_DB_PASSWORD=cambiar_esto

# Administrador de la consola de Keycloak (http://localhost:8180)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar_esto

# Secreto del client "ms-solicitudes" (service account) en Keycloak.
# Lo usa Keycloak al importar el realm y lo usa ms-solicitudes para pedir su token.
MS_SOLICITUDES_CLIENT_SECRET=cambiar_esto
