{
  "realm": "servitec",
  "displayName": "ServiTec",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "CLIENTE",
        "description": "Registra y consulta sus propias solicitudes"
      },
      {
        "name": "TECNICO",
        "description": "Consulta sus trabajos y registra inicio/resolución"
      },
      {
        "name": "ADMIN",
        "description": "Gestiona técnicos, disponibilidades y asignaciones"
      },
      {
        "name": "SERVICIO_INTERNO",
        "description": "Rol de service accounts (comunicación entre microservicios)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "servitec-api",
      "name": "ServiTec API (Postman / Swagger)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:*",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "fullScopeAllowed": true
    },
    {
      "clientId": "ms-solicitudes",
      "name": "ms-solicitudes (service account)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MS_SOLICITUDES_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    }
  ],
